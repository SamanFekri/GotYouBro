# ---------------------------------------------------------------------------
# GotYouBro configuration. Copy to .env and fill in the blanks.
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=6969
LOG_LEVEL=info

# SQLite file. Relative paths resolve from the server/ directory (npm run dev); Docker overrides this.
DATABASE_URL=file:../data/gotyoubro.db

# From @BotFather. Required in production.
TELEGRAM_BOT_TOKEN=
# The official Bot API only accepts uploads up to 50 MB. To allow bigger backups (up to 2000 MB)
# run the local Bot API server (docker compose --profile local-bot-api, see README) and set:
#   TELEGRAM_API_ROOT=http://telegram-bot-api:8081
TELEGRAM_API_ROOT=
# Credentials for the local Bot API server, from https://my.telegram.org (only needed with the profile).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Hard cap enforced before uploading. Empty = 50 (official API) or 2000 (when TELEGRAM_API_ROOT is set).
TELEGRAM_MAX_FILE_MB=

# Your numeric Telegram user id (root admin). Ask @userinfobot if unsure.
ADMIN_TELEGRAM_ID=

# Public HTTPS URL of this server (Telegram Web Apps require HTTPS).
WEBAPP_URL=
# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik).
TRUST_PROXY=false
# Extra allowed browser origins (comma separated). Defaults to WEBAPP_URL's origin.
CORS_ORIGINS=

# Session signing secret, at least 32 random characters: `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Max age of Telegram Web App initData accepted at login.
INIT_DATA_MAX_AGE_SECONDS=86400

# Defaults (admins can change them at runtime in the Web App).
# Rate limits: "60/minute", "30/hour", "100/15m", "unlimited". A bare number uses minutes
# for API/heartbeat limits and hours for backup/service-creation limits.
# Default max backup size. The effective limit is also capped by TELEGRAM_MAX_FILE_MB,
# so backups over 50 MB need the local Bot API server.
MAX_BACKUP_SIZE_MB=1024
MAX_SERVICES_PER_USER=10
# Health monitors per service (a service can watch its API, workers, cron jobs… separately).
MAX_MONITORS_PER_SERVICE=10
DEFAULT_API_RATE_LIMIT=60/minute
DEFAULT_BACKUP_RATE_LIMIT=30/hour
DEFAULT_HEARTBEAT_RATE_LIMIT=10/minute
DEFAULT_SERVICE_CREATE_RATE_LIMIT=10/hour
IP_RATE_LIMIT=300/minute
WEBAPP_RATE_LIMIT=120/minute

# Health monitor tick and defaults for new services.
HEALTH_CHECK_INTERVAL_SECONDS=30
DEFAULT_HEARTBEAT_INTERVAL_SECONDS=60
DEFAULT_HEARTBEAT_GRACE_SECONDS=60

# Backup delivery worker.
BACKUP_CONCURRENCY=2
BACKUP_WAIT_TIMEOUT_SECONDS=600
